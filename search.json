---
layout: null
permalink: /search.json
---
{%- comment -%}
站內搜尋索引。會自動收錄 _data/sections.yml 裡 searchable: true 的分區。
之後加入詩詞時，詩詞檔案只要有 title / author / dynasty 等欄位，也會一起進來。
{%- endcomment -%}
{%- assign n = 0 -%}
[
{%- for sec in site.data.sections -%}
{%- if sec.searchable -%}
{%- assign docs = site[sec.collection] -%}
{%- for d in docs -%}
{%- if n > 0 -%},{%- endif -%}
{%- assign n = n | plus: 1 -%}
{%- assign book = nil -%}{%- if d.source -%}{%- assign book = site.data.sources[d.source.book] -%}{%- endif -%}
{%- assign tags = "" | split: "" -%}
{%- if d.tags -%}{%- assign tags = tags | concat: d.tags -%}{%- endif -%}
{%- assign rel = "" | split: "" -%}
{%- if d.synonyms -%}{%- assign rel = rel | concat: d.synonyms -%}{%- endif -%}
{%- if d.antonyms -%}{%- assign rel = rel | concat: d.antonyms -%}{%- endif -%}
{%- capture src -%}
{%- if d.source -%}
{%- if book.type == 'author' -%}{{ book.name }}〈{{ d.source.chapter }}〉
{%- else -%}《{{ book.name | default: d.source.book }}{% if d.source.chapter != "" and d.source.chapter %}·{{ d.source.chapter }}{% endif %}》
{%- endif -%}
{%- endif -%}
{%- endcapture -%}
{
  "section": {{ sec.label | jsonify }},
  "title": {{ d.title | jsonify }},
  "url": {{ d.url | relative_url | jsonify }},
  "image": {% if d.illustration %}{{ d.illustration | relative_url | jsonify }}{% else %}""{% endif %},
  "pinyin": {{ d.pinyin | default: "" | jsonify }},
  "zhuyin": {{ d.zhuyin | default: "" | jsonify }},
  "tailo": {{ d.tailo | default: "" | jsonify }},
  "kind": {% if d.form %}{{ d.form | jsonify }}{% else %}{{ d.kind | default: "" | jsonify }}{% endif %},
  "summary": {{ d.meaning | default: d.summary | default: "" | jsonify }},
  "source": {{ src | strip | jsonify }},
  "author": {{ d.author | default: "" | jsonify }},
  "tags": {{ tags | jsonify }},
  "related": {{ rel | jsonify }},
  "text": {% if sec.key == 'shici' %}{{ d.lines | join: "" | append: " " | append: d.content | strip_html | strip_newlines | truncate: 600 | jsonify }}{% elsif sec.key == 'wenzhang' %}{{ d.content | strip_html | strip_newlines | truncate: 6000 | jsonify }}{% else %}{{ d.content | strip_html | strip_newlines | truncate: 400 | jsonify }}{% endif %}
}
{%- endfor -%}
{%- endif -%}
{%- endfor -%}
]
